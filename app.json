{
  "expo": {
    "name": "MiShop",
    "slug": "mishop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mishop-icon.png",
    "scheme": "mishop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mishop-icon.png"
    },
    "android": {
      "package": "com.mishop.app",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#159B4A",
        "foregroundImage": "./assets/images/mishop-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MISHOP to use product photos.",
          "cameraPermission": "Allow MISHOP to take product photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-screen.png",
          "imageWidth": 320
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MiShop uses device authentication to protect your app."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0fa25317-84be-465f-9357-f3434e4a6483"
      }
    }
  }
}
